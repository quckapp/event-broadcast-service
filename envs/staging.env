# =============================================================================
# EVENT BROADCAST SERVICE - Staging Environment
# =============================================================================

# Application
MIX_ENV=prod
PORT=4007
PHX_HOST=staging.quckapp.com
PHX_SERVER=true

# Security
SECRET_KEY_BASE=${SECRET_KEY_BASE}
JWT_SECRET=${JWT_SECRET}

# MongoDB
MONGODB_URL=${MONGODB_URL}

# Redis
REDIS_URL=${REDIS_URL}

# Kafka
KAFKA_BROKERS=${KAFKA_BROKERS}

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8081

# Event Configuration
EVENT_RETENTION_DAYS=30
MAX_BATCH_SIZE=1000
EVENT_PROCESSING_INTERVAL_MS=100

# Erlang Distribution
RELEASE_COOKIE=${ERLANG_COOKIE}
NODE_NAME=event@${HOSTNAME}

# Observability
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=true
